# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/admin_scaffold?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT 密钥（必须 >= 32 字符的真实密钥；
# 使用脚手架默认值会被 SaTokenConfig 启动校验拒绝）
JWT_SECRET=local-dev-change-me-to-a-secure-32-char-secret
